  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.25.12",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  }
}
